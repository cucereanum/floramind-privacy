                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Resolved within <strong>30 days</strong>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <footer class="border-t border-gray-100 bg-gray-50 mt-4">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          <img src={iconSrc} alt="" width="28" height="28" class="w-7 h-7 rounded-lg shrink-0 object-cover" />
          <div>
            <p class="text-sm font-semibold text-gray-700">{appName}</p>
            <p class="text-xs text-gray-400">&copy; 2026 {appName}. All rights reserved.</p>
          </div>
        </div>
        <div class="flex flex-col sm:items-end gap-1 text-xs text-gray-400">
          <p>Effective date: <time datetime={effectiveDateISO}>{effectiveDate}</time></p>
          <nav aria-label="Footer navigation" class="flex gap-3">
            <a href={`${base}terms/`} class="text-emerald-600 hover:text-emerald-800 hover:underline underline-offset-2 transition-colors">
              Terms
            </a>
            <a href={`${base}support/`} class="text-emerald-600 hover:text-emerald-800 hover:underline underline-offset-2 transition-colors">
              Support
            </a>
          </nav>
          <a href={`mailto:${contactEmail}`} class="text-emerald-600 hover:text-emerald-800 hover:underline underline-offset-2 transition-colors">
            {contactEmail}
          </a>
        </div>
      </div>
    </div>
  </footer>

</Layout>

<style>
