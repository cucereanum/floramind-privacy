    @apply bg-white border border-gray-200 rounded-2xl p-5 shadow-sm;
  }

  .card-title {
    @apply font-semibold text-gray-800 text-sm mb-3 flex flex-wrap items-center gap-2;
  }

  .body-text {
    @apply text-[15px] text-gray-600 leading-[1.75];
  }

  .footnote {
    @apply text-xs text-gray-400 leading-relaxed;
  }

  .link {
    @apply text-emerald-700 underline underline-offset-2 hover:text-emerald-900 transition-colors;
  }

  .badge {
    @apply text-[11px] font-normal font-sans text-emerald-700
           bg-emerald-50 border border-emerald-200
           px-2 py-0.5 rounded-full;
  }

  .badge-warn {
    @apply text-[11px] font-normal font-sans text-amber-800
           bg-amber-50 border border-amber-300
           px-2 py-0.5 rounded-full;
  }

  .bullet-list {
    @apply space-y-2 list-none;
  }
  .bullet-list li {
    @apply flex items-start gap-2.5 text-[15px] text-gray-600 leading-[1.75];
  }
  .bullet-list li::before {
    content: '';
    @apply mt-[0.55em] w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0;
  }

  code {
    @apply font-mono text-[13px] bg-gray-100 border border-gray-200 px-1 py-0.5 rounded;
  }

  .sla-chip {
    @apply inline-flex items-center gap-1.5 text-xs text-gray-600
           bg-white border border-emerald-200 px-3 py-1.5 rounded-full;
  }

  .alert {
    @apply rounded-2xl border-2 border-amber-300 bg-amber-50 p-5 text-[15px] text-amber-950 leading-[1.75];
  }
  .alert-title {
    @apply flex items-center gap-2 font-bold text-amber-900 text-sm mb-2;
  }

  .notice {
    @apply rounded-2xl border border-amber-200 bg-amber-50/60 p-5 text-[15px] text-amber-950 leading-[1.75];
  }
  .notice-title {
    @apply font-bold text-amber-900 text-sm mb-2;
  }

  .alert .link,
  .notice .link {
    @apply text-amber-900 underline underline-offset-2 hover:text-amber-950;
  }
</style>
