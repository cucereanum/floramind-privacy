---
import Layout from '../layouts/Layout.astro';

const effectiveDate    = 'August 28, 2026';
const effectiveDateISO = '2026-08-28';
const appName          = 'FloraMind';
const appVersion       = '1.0.0';
const contactEmail     = 'cucereanumdev@gmail.com';

const description =
  `Privacy Policy for the ${appName} plant care app (iOS and Android). ` +
  `What we collect, where your photos are stored, who we share data with, and your rights.`;

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
const iconSrc = `${base}icon.png`;

const toc = [
  ['#introduction',           '1. Introduction'],
  ['#data-controller',        '2. Data Controller'],
  ['#information-we-collect', '3. Information We Collect'],
  ['#photos',                 '4. Your Photos — Where Each One Goes'],
  ['#location',               '5. Location Data'],
  ['#ai-processing',          '6. AI Processing'],
  ['#legal-basis',            '7. Legal Basis for Processing'],
  ['#how-we-use',             '8. How We Use Your Information'],
  ['#storage-security',       '9. Storage, Security and Retention'],
  ['#international-transfers','10. International Data Transfers'],
  ['#sharing',                '11. Data Sharing and Third Parties'],
  ['#your-rights',            '12. Your Rights'],
  ['#california',             '13. California Privacy Rights'],
  ['#children',               "14. Children's Privacy"],
  ['#changes',                '15. Changes to This Policy'],
  ['#contact',                '16. Contact Us'],
] as const;

const notCollected = [
  'Device advertising identifiers, or any identifier used for cross-app tracking',
  'Contacts or address book',
  'Microphone access',
  'Camera or photo library access beyond the photos you explicitly submit',
  'Continuous or background location — coordinates are read only at the moment you take an identification or discovery photo, and only if you granted permission',
  'Browsing history or behavioural analytics',
  'Payment or financial information — app distribution is handled by the Apple App Store and Google Play, and we never receive payment card data',
  'Crash reports, session recordings, or usage telemetry — no third-party analytics or crash-reporting services are integrated',
] as const;

const rightsCards = [
  { right: 'Access',        desc: 'Request a copy of all personal data we hold about you in a structured, intelligible format.' },
  { right: 'Rectification', desc: 'Request correction of inaccurate or incomplete personal data without undue delay.' },
  { right: 'Erasure',       desc: 'Delete your account in the app at any time. Removal of your server-side data is immediate, not queued.' },
  { right: 'Portability',   desc: 'Receive your plant library, discoveries and scan history in a structured, commonly used, machine-readable format.' },
  { right: 'Restriction',   desc: 'Request that we restrict further processing of your data while a dispute or objection is under review.' },
  { right: 'Objection',     desc: 'Object at any time to processing we base on legitimate interests, and withdraw consent for location processing at any time.' },
] as const;

const retention = [
  ['Account record (email, display name, password hash)',     'Until you delete your account — then removed immediately'],
  ['Plant library, care schedules and care logs',             'Until you delete the plant or your account — then removed immediately'],
  ['Saved plant photos and discovery photos (Cloudflare R2)', 'Stored indefinitely until the plant, the discovery or your account is deleted'],
  ['Discovery coordinates and place name',                    'Stored indefinitely until the discovery or your account is deleted'],
  ['Scan and diagnosis history (text results)',               'Until you delete the plant or your account'],
  ['Identification and diagnosis photos',                     'Never written to our storage — held in memory only for the duration of the request'],
  ['IP address in the rate-limiting table',                   'Automatically purged within 24 hours'],
  ['Feedback you send us (with your email address and name)', 'Held in our support mailbox for as long as needed to answer you'],
] as const;
---

<Layout title={`Privacy Policy — ${appName}`} {description}>

  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-1.5 focus:bg-emerald-700 focus:text-white focus:rounded-lg focus:text-sm">
    Skip to content
  </a>

  <header id="top" class="sticky top-0 z-20 bg-white/95 backdrop-blur-sm border-b border-gray-200 shadow-sm">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <img src={iconSrc} alt={appName} class="w-8 h-8 rounded-lg shrink-0 object-cover" />
        <span class="font-semibold text-gray-900 text-sm sm:text-base truncate">
          {appName} <span class="text-gray-400 font-normal mx-1 hidden sm:inline">—</span>
          <span class="text-gray-500 font-normal hidden sm:inline">Privacy Policy</span>
        </span>
      </div>
      <a
        href="#top"
        class="shrink-0 text-xs sm:text-sm font-medium text-emerald-700 hover:text-emerald-900 hover:underline underline-offset-2 transition-colors flex items-center gap-1"
        aria-label="Back to top"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd"/>
        </svg>
        Top
      </a>
    </div>
  </header>

  <main id="main-content" class="max-w-3xl mx-auto px-4 sm:px-6">

    <section class="py-10 sm:py-14 border-b border-gray-100" aria-labelledby="policy-title">
      <div class="flex items-start gap-4">
        <img
          src={iconSrc}
          alt=""
          width="64"
          height="64"
          class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl shadow-lg shadow-emerald-200 shrink-0 mt-1 object-cover"
        />
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-600 mb-1">{appName}</p>
          <h1 id="policy-title" class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight leading-tight mb-3">
            Privacy Policy
          </h1>
          <p class="text-sm text-gray-500">
            Effective date:&nbsp;<time datetime={effectiveDateISO} class="font-medium text-gray-700">{effectiveDate}</time>
            <span class="mx-2 text-gray-300">|</span>
            App version:&nbsp;<span class="font-medium text-gray-700">{appVersion}</span>
          </p>
        </div>
      </div>

      <p class="mt-6 text-gray-600 text-[15px] leading-[1.75] max-w-2xl">
        This Privacy Policy governs the collection, use, storage, and disclosure of personal information by
        <strong>{appName}</strong> in connection with its iOS and Android mobile application
        (the &ldquo;Application&rdquo;). It sets out the rights available to users and the obligations we
        assume as data controller. We do not serve advertising within the Application, operate third-party
        analytics pipelines, or integrate crash-reporting services.
      </p>

      <p class="mt-4 text-gray-600 text-[15px] leading-[1.75] max-w-2xl">
        Photographs are handled in four different ways depending on what you use them for, and only some of
        them are stored by us. <a href="#photos" class="link">Section&nbsp;4</a> sets out exactly which photo
        goes where, including the fact that stored photos are served from a public web address.
      </p>
    </section>

    <nav class="my-10 p-5 sm:p-6 rounded-2xl bg-gray-50 border border-gray-200" aria-label="Table of contents">
      <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">Contents</p>
      <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm list-none p-0 m-0">
        {toc.map(([href, label]) => (
          <li>
            <a
              href={href}
              class="group flex items-center gap-2 text-gray-600 hover:text-emerald-700 transition-colors py-0.5"
            >
              <span class="w-1 h-1 rounded-full bg-emerald-400 group-hover:bg-emerald-600 shrink-0 transition-colors" aria-hidden="true"></span>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="space-y-14 pb-20">

      <!-- 1. INTRODUCTION -->
      <section id="introduction" aria-labelledby="h-intro">
        <h2 id="h-intro" class="section-heading">Introduction</h2>
        <div class="card space-y-3 body-text">
          <p>
            <strong>{appName}</strong> (&ldquo;we&rdquo;, &ldquo;us&rdquo;, &ldquo;our&rdquo;) develops and operates
            the <strong>{appName}</strong> mobile application for <strong>iOS and Android</strong>. The Application
            enables users to track houseplants, manage care schedules, review care history, submit photographs
            for AI-assisted plant identification and health diagnosis, and record wild plants they encounter
            as &ldquo;discoveries&rdquo;.
          </p>
          <p>
            This Privacy Policy applies to all users of the Application regardless of geographic location and
            constitutes a legally binding statement of our data-handling practices. By downloading, installing,
            or using the Application, you acknowledge that you have read and understood this Policy. Where your
            use of the Application is subject to a separate end-user licence agreement, this Policy is incorporated
            into and forms part of that agreement.
          </p>
          <p>
            If you do not accept the terms of this Policy, you must discontinue use of the Application and, if
            you hold a registered account, exercise your right to deletion as described in
            <a href="#your-rights" class="link">Section 12 (Your Rights)</a>.
          </p>
          <p>
            <strong>{appName} does not sell personal information and does not disclose it to third parties
            for their own marketing or advertising purposes.</strong>
          </p>
        </div>
      </section>

      <!-- 2. DATA CONTROLLER -->
      <section id="data-controller" aria-labelledby="h-controller">
        <h2 id="h-controller" class="section-heading">Data Controller</h2>
        <div class="card body-text space-y-3">
          <p>
            For the purposes of applicable data-protection legislation, including the General Data Protection
            Regulation (EU) 2016/679 (&ldquo;GDPR&rdquo;) and the UK GDPR, the data controller responsible
            for personal information processed through the Application is:
          </p>
          <address class="not-italic pl-4 border-l-2 border-emerald-300 space-y-1 text-gray-700">
            <p class="font-semibold">{appName}</p>
            <p>
              <a href={`mailto:${contactEmail}`} class="link">{contactEmail}</a>
            </p>
          </address>
          <p>
            All privacy enquiries, data-subject requests, and security disclosures should be directed to the
            contact address above. We will acknowledge receipt within <strong>5 business days</strong>.
          </p>
        </div>
      </section>

      <!-- 3. INFORMATION WE COLLECT -->
      <section id="information-we-collect" aria-labelledby="h-collect">
        <h2 id="h-collect" class="section-heading">Information We Collect</h2>

        <div class="space-y-4">

          <div class="card">
            <h3 class="card-title">
              Account Data
              <span class="badge">Optional — registration only</span>
            </h3>
            <p class="body-text mb-3">
              Plant identification works without an account, including during onboarding. Users who create an
              account for cross-device synchronisation provide the following:
            </p>
            <ul class="bullet-list">
              <li><strong>Email address</strong> — your primary account identifier and login credential.</li>
              <li><strong>Password</strong> — transmitted over an encrypted connection and stored exclusively as a one-way BCrypt hash. We are technically unable to retrieve or reconstruct your original password.</li>
              <li><strong>Display name</strong> — a user-selected name displayed within the Application.</li>
              <li><strong>Sign in with Google or Apple</strong> — if you use one of these instead of a password, we receive your <strong>email address, name, and a provider user ID</strong> from that provider and store them on your account record.</li>
            </ul>
            <p class="footnote mt-3">
              We do not currently send email to users. There is no email-verification step and no
              password-reset email, so please do not treat email verification as a security control on your
              account. See <a href="#storage-security" class="link">Section&nbsp;9</a>.
            </p>
          </div>

          <div class="card">
            <h3 class="card-title">Plant Library Data</h3>
            <p class="body-text mb-3">
              Content you enter into your plant collection, which is stored on our servers once you have an
              account:
            </p>
            <ul class="bullet-list">
              <li><strong>Plant name and species</strong></li>
              <li><strong>Room or location label</strong></li>
              <li><strong>Notes</strong></li>
              <li><strong>Care schedules</strong> — including watering, fertilising, and repotting intervals</li>
              <li><strong>Care history</strong> — a log of completed care actions</li>
              <li><strong>Scan and diagnosis history</strong> — the AI-generated species and care information, and past health assessments, kept per plant</li>
              <li><strong>Photographs</strong> — see <a href="#photos" class="link">Section&nbsp;4</a>, which sets out where each kind of photo is stored</li>
            </ul>
          </div>

          <div class="card">
            <h3 class="card-title">Discoveries</h3>
            <p class="body-text">
              When you record a wild plant as a discovery, we store the AI-generated result, the photograph,
              and — if you granted location permission — the <strong>exact latitude and longitude</strong> of
              the discovery together with an optional place name. Coordinates attached to a discovery are
              retained indefinitely, until you delete the discovery or your account.
            </p>
          </div>

          <div class="card">
            <h3 class="card-title">
              IP Address
              <span class="badge">Guests and signed-in users alike</span>
            </h3>
            <p class="body-text">
              Every request that consumes AI capacity is rate-limited. To do that we record the requesting
              <strong>IP address in a rate-limiting table</strong>. IPv6 addresses are truncated to their
              <code>/64</code> prefix before storage. These records are
              <strong>automatically purged within 24 hours</strong> and are not used to profile you, build a
              usage history, or serve advertising. This applies whether or not you are signed in.
            </p>
          </div>

          <div class="card">
            <h3 class="card-title">Feedback You Send Us</h3>
            <p class="body-text">
              If you submit feedback from within the Application, the message is delivered to our own inbox
              by <strong>Resend</strong>, an email delivery provider acting as our processor. The message body
              includes <strong>your email address and display name</strong> alongside your feedback text, so
              that we can reply. Resend is used for this one purpose only; we do not send you marketing,
              notification, verification, or password-reset email.
            </p>
          </div>

          <div class="card !border-emerald-200 !bg-emerald-50/50">
            <h3 class="card-title !text-emerald-800">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
              </svg>
              Data Processed Exclusively On-Device
            </h3>
            <p class="body-text mb-3">
              The following data is stored and processed solely on your device and is <strong>never uploaded
              to our servers</strong>:
            </p>
            <ul class="bullet-list">
              <li>
                <strong>Authentication tokens</strong> — stored within your device&apos;s platform-managed secure
                credential storage (iOS Keychain or Android Keystore). These tokens are accessible only by
                the Application.
              </li>
              <li>
                <strong>User preferences</strong> — notification settings, quiet-hour configuration, onboarding
                completion state, language overrides, daily identification usage counters, and notification
                history — stored in encrypted local storage on-device.
              </li>
              <li>
                <strong>Reminder schedules</strong> — implemented entirely via local on-device notifications.
                We do not receive push notification tokens or the content of your configured reminders.
              </li>
            </ul>
          </div>

          <div class="card">
            <h3 class="card-title">Information We Do Not Collect</h3>
            <p class="body-text mb-3">
              The Application does not collect, process, or transmit the following categories of information:
            </p>
            <ul class="space-y-2 text-[15px] text-gray-600 list-none">
              {notCollected.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 flex items-center justify-center w-4 h-4 rounded-full bg-rose-100 text-rose-500 text-[10px] font-bold shrink-0" aria-hidden="true">✕</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </section>

      <!-- 4. PHOTOS -->
      <section id="photos" aria-labelledby="h-photos">
        <h2 id="h-photos" class="section-heading">Your Photos — Where Each One Goes</h2>

        <p class="body-text mb-5">
          The Application uses photographs in four different ways, and they are <strong>not</strong> handled
          the same way. Please read this section rather than assuming.
        </p>

        <div class="alert mb-5">
          <p class="alert-title">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            Stored photos are served from a public address
          </p>
          <p>
            Saved plant photos and discovery photos are kept in a <strong>public-read storage bucket</strong>,
            and each file&apos;s web address is derived from the plant or discovery identifier. In practice this
            means: <strong>anyone who has the address of one of these photos — or who guesses it — can open it
            without signing in.</strong> These photos are <em>not</em> access-controlled, and we ask you not to
            treat them as private. Please do not photograph anything you would not want viewed by someone
            outside the Application, including the interior of your home, documents, other people, or anything
            that identifies where you live.
          </p>
        </div>

        <div class="space-y-4">

          <div class="card">
            <h3 class="card-title">
              1. Plant identification
              <span class="badge">Not stored by us</span>
            </h3>
            <p class="body-text">
              When you photograph a plant to identify it — including during guest onboarding, before you have
              an account — the image is re-encoded in memory and sent to <strong>Google Gemini</strong> for
              analysis. It is <strong>not written to our storage and not retained by us</strong>. The AI&apos;s
              text output (species, care information) is saved only if you have already saved that plant to
              your library.
            </p>
          </div>

          <div class="card">
            <h3 class="card-title">
              2. Photos you save to a plant
              <span class="badge-warn">Stored indefinitely · public URL</span>
            </h3>
            <p class="body-text">
              When you attach a photo to a plant in your library, that image <strong>is uploaded to our image
              storage</strong> (Cloudflare R2) and kept there until you delete the plant or your account. It is
              stored at a predictable address of the form
              <code>&#123;environment&#125;/plants/&#123;plantId&#125;.jpg</code> in a public-read bucket, and is
              therefore reachable by anyone who has or guesses that address.
            </p>
          </div>

          <div class="card">
            <h3 class="card-title">
              3. Wild plant discoveries
              <span class="badge-warn">Stored indefinitely · public URL</span>
            </h3>
            <p class="body-text">
              A discovery photo is <strong>both</strong> sent to Google Gemini for analysis <strong>and</strong>
              stored in the same public-read bucket, at
              <code>&#123;environment&#125;/discoveries/&#123;discoveryId&#125;.jpg</code>. The same public-address
              caveat applies. If you granted location permission, the discovery record also holds the exact
              coordinates where the photo was taken — see <a href="#location" class="link">Section&nbsp;5</a>.
            </p>
          </div>

          <div class="card">
            <h3 class="card-title">
              4. Health diagnosis
              <span class="badge">Photo not stored · history is</span>
            </h3>
            <p class="body-text">
              When you ask for a health assessment of one of your plants, the photo is sent to Google Gemini
              and is <strong>not stored by us</strong>. To produce a better assessment, we also send Gemini
              <strong>that plant&apos;s previous scan and diagnosis history</strong> as context. That history is
              text we already hold in your plant library.
            </p>
          </div>

          <div class="card !border-emerald-200 !bg-emerald-50/50">
            <h3 class="card-title !text-emerald-800">Metadata is stripped</h3>
            <p class="body-text">
              Every image you submit is re-encoded to JPEG before it is stored or transmitted. This
              <strong>removes EXIF metadata, including any GPS coordinates your camera embedded in the
              file</strong>. Location reaches us only through the separate, permission-gated path described in
              <a href="#location" class="link">Section&nbsp;5</a> — never silently through a photo.
            </p>
          </div>

        </div>
      </section>

      <!-- 5. LOCATION -->
      <section id="location" aria-labelledby="h-location">
        <h2 id="h-location" class="section-heading">Location Data</h2>
        <div class="card body-text space-y-3">
          <p>
            Location is <strong>optional</strong>. If you grant the Application location permission, it sends
            your <strong>latitude and longitude</strong> with plant identification and discovery requests. If
            you decline, or later revoke the permission in your device settings, those features continue to
            work without it.
          </p>
          <p>Two separate things happen with those coordinates:</p>
          <ul class="bullet-list">
            <li>
              <strong>They are sent to Open-Meteo</strong> (<code>api.open-meteo.com</code>), a third-party
              weather service, to look up local temperature, humidity and precipitation so that care advice
              matches your actual conditions. Your <strong>exact coordinates leave our systems</strong> when
              this lookup happens. Open-Meteo is a separate recipient of that data and handles it under its
              own terms.
            </li>
            <li>
              <strong>For discoveries only, they are stored.</strong> The exact latitude, longitude and an
              optional place name are written to our database as part of the discovery record and kept
              <strong>indefinitely</strong>, until you delete the discovery or your account.
            </li>
          </ul>
          <p>
            We process location on the basis of your <strong>consent</strong> (GDPR Art. 6(1)(a)), given
            through your device&apos;s location permission prompt. You may withdraw that consent at any time by
            revoking the permission in your device settings. Withdrawal does not affect processing carried out
            before you withdrew, and existing discovery records keep their stored coordinates until you delete
            them.
          </p>
        </div>
      </section>

      <!-- 6. AI PROCESSING -->
      <section id="ai-processing" aria-labelledby="h-ai">
        <h2 id="h-ai" class="section-heading">AI Processing</h2>
        <div class="space-y-4">
          <div class="card body-text space-y-3">
            <p>
              Plant identification, health diagnosis and wild-plant discovery are performed by
              <strong>Google Gemini</strong>, operated by Google LLC. We send Gemini the photograph, your
              language preference, local weather data where available, and — for a diagnosis — the previous
              scan and diagnosis history for that plant.
            </p>
            <p>
              Under the terms on which we use Gemini, <strong>Google does not use the data we submit to train
              or improve its models</strong>. Google may retain submitted data transiently for abuse
              monitoring. Processing may take place on servers in the United States or in other countries
              outside the EEA and the UK.
            </p>
          </div>

          <div class="card body-text">
            <p>
              We do not use your personal data for automated decision-making producing legal or similarly
              significant effects. AI results are informational only — see our
              <a href={`${base}terms/`} class="link">Terms of Service</a>, which contain an important safety
              disclaimer about wild-plant edibility and toxicity information.
            </p>
          </div>
        </div>
      </section>

      <!-- 7. LEGAL BASIS -->
      <section id="legal-basis" aria-labelledby="h-legal">
        <h2 id="h-legal" class="section-heading">Legal Basis for Processing</h2>
        <div class="card body-text space-y-3">
          <p>
            Where the GDPR or equivalent legislation applies, we rely on the following legal bases for
            processing personal data:
          </p>
          <div class="overflow-x-auto -mx-1">
            <table class="w-full text-[14px] min-w-[480px] border-separate border-spacing-0">
              <thead>
                <tr class="bg-gray-50">
                  <th scope="col" class="text-left px-4 py-3 text-xs font-semibold uppercase tracking-wide text-gray-500 border-b border-gray-200 rounded-tl-lg">Processing activity</th>
                  <th scope="col" class="text-left px-4 py-3 text-xs font-semibold uppercase tracking-wide text-gray-500 border-b border-gray-200 rounded-tr-lg">Legal basis (GDPR Art. 6)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <tr class="bg-white hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3 text-gray-700">Account creation and authentication</td>
                  <td class="px-4 py-3 text-gray-500">Art. 6(1)(b) — Performance of a contract</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3 text-gray-700">Storing and synchronising your plant library, photos and discoveries</td>
                  <td class="px-4 py-3 text-gray-500">Art. 6(1)(b) — Performance of a contract</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3 text-gray-700">Identification, diagnosis and discovery (photograph sent to Google Gemini)</td>
                  <td class="px-4 py-3 text-gray-500">Art. 6(1)(b) — Performance of a contract</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3 text-gray-700">Location: weather lookup via Open-Meteo, and storage of discovery coordinates</td>
                  <td class="px-4 py-3 text-gray-500"><strong class="text-gray-700">Art. 6(1)(a) — Consent</strong>, given through the device location permission and withdrawable at any time</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3 text-gray-700">IP-based rate limiting and abuse prevention</td>
                  <td class="px-4 py-3 text-gray-500">Art. 6(1)(f) — Legitimate interests: preventing abuse of a paid AI service and keeping it available to genuine users</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3 text-gray-700">Handling feedback and support enquiries</td>
                  <td class="px-4 py-3 text-gray-500">Art. 6(1)(f) — Legitimate interests: answering the person who contacted us</td>
                </tr>
                <tr class="bg-white hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3 text-gray-700">Compliance with legal obligations</td>
                  <td class="px-4 py-3 text-gray-500">Art. 6(1)(c) — Legal obligation</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p>
            Where we rely on legitimate interests as our legal basis, we have conducted a balancing assessment
