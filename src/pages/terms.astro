---
import Layout from '../layouts/Layout.astro';

const effectiveDate    = 'August 28, 2026';
const effectiveDateISO = '2026-08-28';
const appName          = 'FloraMind';
const appVersion       = '1.0.0';
const contactEmail     = 'cucereanumdev@gmail.com';

const description =
  `Terms of Service for the ${appName} plant care app (iOS and Android). ` +
  `Your rights and responsibilities, usage limits, AI accuracy, wild-plant safety, and user content.`;

const base    = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
const iconSrc = `${base}icon.png`;

const toc = [
  ['#acceptance',       '1. Acceptance of Terms'],
  ['#service',          '2. Description of Service'],
  ['#accounts',         '3. Accounts'],
  ['#guest-use',        '4. Guest Use'],
  ['#usage-limits',     '5. Usage Limits and AI Availability'],
  ['#user-content',     '6. User Content'],
  ['#acceptable-use',   '7. Acceptable Use'],
  ['#ip',               '8. Intellectual Property'],
  ['#third-parties',    '9. Third-Party Services'],
  ['#ai-disclaimer',    '10. AI Results — Accuracy and Safety'],
  ['#disclaimers',      '11. General Disclaimers'],
  ['#liability',        '12. Limitation of Liability'],
  ['#termination',      '13. Termination and Suspension'],
  ['#changes',          '14. Changes to These Terms'],
  ['#governing-law',    '15. Governing Law and Disputes'],
  ['#contact',          '16. Contact'],
] as const;
---

<Layout title={`Terms of Service — ${appName}`} {description}>

  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-1.5 focus:bg-emerald-700 focus:text-white focus:rounded-lg focus:text-sm">
    Skip to content
  </a>

  <header id="top" class="sticky top-0 z-20 bg-white/95 backdrop-blur-sm border-b border-gray-200 shadow-sm">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <img src={iconSrc} alt={appName} class="w-8 h-8 rounded-lg shrink-0 object-cover" />
        <span class="font-semibold text-gray-900 text-sm sm:text-base truncate">
          {appName} <span class="text-gray-400 font-normal mx-1 hidden sm:inline">—</span>
          <span class="text-gray-500 font-normal hidden sm:inline">Terms of Service</span>
        </span>
      </div>
      <a
        href="#top"
        class="shrink-0 text-xs sm:text-sm font-medium text-emerald-700 hover:text-emerald-900 hover:underline underline-offset-2 transition-colors flex items-center gap-1"
        aria-label="Back to top"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd"/>
        </svg>
        Top
      </a>
    </div>
  </header>

  <main id="main-content" class="max-w-3xl mx-auto px-4 sm:px-6">

    <section class="py-10 sm:py-14 border-b border-gray-100" aria-labelledby="terms-title">
      <div class="flex items-start gap-4">
        <img
          src={iconSrc}
          alt=""
          width="64"
          height="64"
          class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl shadow-lg shadow-emerald-200 shrink-0 mt-1 object-cover"
        />
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-600 mb-1">{appName}</p>
          <h1 id="terms-title" class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight leading-tight mb-3">
            Terms of Service
          </h1>
          <p class="text-sm text-gray-500">
            Effective date:&nbsp;<time datetime={effectiveDateISO} class="font-medium text-gray-700">{effectiveDate}</time>
            <span class="mx-2 text-gray-300">|</span>
            App version:&nbsp;<span class="font-medium text-gray-700">{appVersion}</span>
          </p>
        </div>
      </div>

      <p class="mt-6 text-gray-600 text-[15px] leading-[1.75] max-w-2xl">
        These Terms of Service (&ldquo;Terms&rdquo;) govern your use of the <strong>{appName}</strong> iOS
        and Android application (the &ldquo;Application&rdquo;). Please read them carefully before using
        the Application. By downloading, installing, or using the Application, you agree to be bound by
        these Terms. If you do not agree, do not use the Application.
      </p>

      <div class="alert mt-6">
        <p class="alert-title">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          Never eat, touch, or administer a plant on the strength of what this app tells you
        </p>
        <p>
          The discovery feature returns information about edibility, medicinal use, toxicity and
          conservation status. It is generated by an AI model, it is frequently wrong about
          look-alike species, and <strong>misidentifying a wild plant can kill or seriously injure you, a
          child, or an animal</strong>. Section&nbsp;10 sets out this disclaimer in full — please read it.
        </p>
      </div>

      <p class="mt-4 text-gray-600 text-[15px] leading-[1.75] max-w-2xl">
        These terms cover how many AI requests you may make, what you may do with the photographs and results
        the service produces, and the limits of the advice it gives. Our
        <a href={`${base}privacy-policy/`} class="link">Privacy Policy</a>, updated on the same date,
        describes what happens to your photographs and where they are stored.
      </p>
    </section>

    <nav class="my-10 p-5 sm:p-6 rounded-2xl bg-gray-50 border border-gray-200" aria-label="Table of contents">
      <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">Contents</p>
      <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm list-none p-0 m-0">
        {toc.map(([href, label]) => (
          <li>
            <a
              href={href}
              class="group flex items-center gap-2 text-gray-600 hover:text-emerald-700 transition-colors py-0.5"
            >
              <span class="w-1 h-1 rounded-full bg-emerald-400 group-hover:bg-emerald-600 shrink-0 transition-colors" aria-hidden="true"></span>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="space-y-14 pb-20">

      <!-- 1. ACCEPTANCE -->
      <section id="acceptance" aria-labelledby="h-acceptance">
        <h2 id="h-acceptance" class="section-heading">Acceptance of Terms</h2>
        <div class="card body-text space-y-3">
          <p>
            By accessing or using <strong>{appName}</strong>, you confirm that you are at least 13 years of
            age (or the applicable minimum age of digital consent in your jurisdiction, which is higher in
            most EU member states), that you have the legal capacity to enter into a binding agreement, and
            that you accept these Terms in full. We rely on that confirmation and do not carry out further
            age verification.
          </p>
          <p>
            If you are using the Application on behalf of an organisation, you represent that you have the
            authority to bind that organisation to these Terms, and the term &ldquo;you&rdquo; refers to
            that organisation.
          </p>
          <p>
            Use of the Application is also subject to our
            <a href={`${base}privacy-policy/`} class="link">Privacy Policy</a>, which is incorporated into
            these Terms by reference.
          </p>
        </div>
      </section>

      <!-- 2. SERVICE -->
      <section id="service" aria-labelledby="h-service">
        <h2 id="h-service" class="section-heading">Description of Service</h2>
        <div class="card body-text space-y-3">
          <p>
            {appName} is a plant care application for iOS and Android that allows you to:
          </p>
          <ul class="bullet-list">
            <li>Track houseplants and manage care schedules (watering, fertilising, repotting)</li>
            <li>Receive local on-device reminders for upcoming care tasks</li>
            <li>Log care history and keep photos of your plants</li>
            <li>Submit plant photographs for AI-assisted identification and health diagnosis</li>
            <li>Record wild plants you encounter as &ldquo;discoveries&rdquo;, optionally with the location where you found them</li>
            <li>Sync your plant library across devices via a registered account</li>
          </ul>
          <p>
            Plant identification is available without an account, including during onboarding. AI features
            require an internet connection; your photographs are processed on our servers and by Google
            Gemini, not on your device.
          </p>
          <p>
            We reserve the right to modify, suspend, or discontinue any feature or the Application as a whole
            at any time.
          </p>
        </div>
      </section>

      <!-- 3. ACCOUNTS -->
      <section id="accounts" aria-labelledby="h-accounts">
        <h2 id="h-accounts" class="section-heading">Accounts</h2>
        <div class="card body-text space-y-3">
          <p>
            To sync your library across devices you must register an account with an email address and
            password, or sign in with Google or Apple. You are responsible for:
          </p>
          <ul class="bullet-list">
            <li>Providing accurate and current registration information</li>
            <li>Keeping your password confidential and not sharing account credentials</li>
            <li>All activity that occurs under your account</li>
            <li>Notifying us promptly at <a href={`mailto:${contactEmail}`} class="link">{contactEmail}</a> if you become aware of any unauthorised use</li>
          </ul>
          <p>
            <strong>There is currently no password reset and no email verification.</strong> We do not send
            email to users, so if you lose access to a password-based account we cannot restore it by email;
            please keep your credentials safe, or use Sign in with Google or Apple.
          </p>
          <p>
            We may suspend or terminate accounts that violate these Terms, are associated with abusive
            behaviour, or pose a security risk to other users or to our infrastructure — see
            <a href="#termination" class="link">Section&nbsp;13</a>.
          </p>
          <p>
            You may delete your account at any time via <strong>Settings → Account → Delete Account</strong>.
            Deletion of your server-side data is immediate; what is removed is listed in our
            <a href={`${base}privacy-policy/`} class="link">Privacy Policy</a>.
          </p>
        </div>
      </section>

      <!-- 4. GUEST USE -->
      <section id="guest-use" aria-labelledby="h-guest">
        <h2 id="h-guest" class="section-heading">Guest Use</h2>
        <div class="card body-text space-y-3">
          <p>
            You may use {appName} without registering an account (&ldquo;Guest Mode&rdquo;). Your plant
            records are then kept on your device. Note that <strong>plant identification still sends your
            photograph to our servers and to Google Gemini</strong>, whether or not you have an account, and
            that guest requests are rate-limited by IP address and device as described in
            <a href="#usage-limits" class="link">Section&nbsp;5</a>.
          </p>
          <p>
            If you uninstall the Application while in Guest Mode, all locally stored data will be permanently
            lost. We are not liable for data loss resulting from uninstallation, device failure, or factory
            reset while using Guest Mode.
          </p>
          <p>
            When you create a registered account on a device that already contains guest data, {appName}
            will upload your local plant library to your new account. This migration is a one-time operation
            and cannot be undone.
          </p>
        </div>
      </section>

      <!-- 5. USAGE LIMITS -->
      <section id="usage-limits" aria-labelledby="h-limits">
        <h2 id="h-limits" class="section-heading">Usage Limits and AI Availability</h2>
        <div class="card body-text space-y-3">
          <p>
            AI processing costs us money on every request, so it is rationed. You acknowledge and agree that:
          </p>
          <ul class="bullet-list">
            <li>
              <strong>Plant identification, discovery scans and health diagnoses are each capped per day</strong>,
              and those caps are applied <strong>per account and per device</strong>.
            </li>
            <li>
              The service may <strong>refuse further AI requests once a global daily budget is reached</strong>,
              regardless of your own usage that day.
            </li>
            <li>
              <strong>You are not entitled to any fixed number of AI requests.</strong> Limits, budgets and
              the availability of AI features may change at any time, without notice, and are not part of any
              promise made to you.
            </li>
            <li>
              Requests are rate-limited by IP address, device and account. Guests are subject to the same
              mechanism.
            </li>
          </ul>
          <p>
            Refusal of an AI request because a limit or budget was reached is normal operation of the
            Application, not a defect, and does not entitle you to any remedy.
          </p>
        </div>
      </section>

      <!-- 6. USER CONTENT -->
      <section id="user-content" aria-labelledby="h-content">
        <h2 id="h-content" class="section-heading">User Content</h2>
        <div class="card body-text space-y-3">
          <p>
            &ldquo;User Content&rdquo; means any data, text, photographs, or other material you submit to
            the Application, including plant records, notes, care logs, discoveries, and photographs you
            upload for identification, diagnosis, or to a plant in your library.
          </p>
          <p>
            You retain full ownership of your User Content. By submitting User Content you grant {appName} a
            limited, non-exclusive, royalty-free licence to store, process, and transmit that content solely
            to the extent necessary to provide the services described in these Terms — specifically, to store
            and synchronise your data across your devices and to send photographs to our AI provider for
            analysis. This licence terminates when you delete the relevant content or your account.
          </p>
          <p>
            <strong>You represent and warrant that you have the right to upload every photograph you
            submit</strong>, and specifically that:
          </p>
          <ul class="bullet-list">
            <li>You own the photograph or have permission from its owner to submit it</li>
            <li>Your User Content does not infringe any third-party intellectual property, privacy, or other rights</li>
            <li>Where a photograph shows an identifiable person, you have that person&apos;s consent</li>
            <li>Your User Content does not contain material that is unlawful, harmful, or offensive</li>
          </ul>
          <p>
            <strong>Photographs you save to a plant or to a discovery are stored on a public-read bucket at
            predictable web addresses</strong>, which means anyone who has or guesses the address can view
            them without signing in. This is described fully in our
            <a href={`${base}privacy-policy/`} class="link">Privacy Policy</a>. Please take it into account
            when deciding what to photograph.
          </p>
          <p>
            We do not review User Content before it is stored, and we are not responsible for the accuracy
            or legality of content you submit. We may remove User Content that violates these Terms.
          </p>
        </div>
      </section>

      <!-- 7. ACCEPTABLE USE -->
      <section id="acceptable-use" aria-labelledby="h-use">
        <h2 id="h-use" class="section-heading">Acceptable Use</h2>
        <div class="card body-text space-y-3">
          <p>You agree not to:</p>
          <ul class="bullet-list">
            <li>Violate any applicable law or regulation</li>
            <li>Attempt to gain unauthorised access to our servers, infrastructure, storage, or other users&apos; accounts or content</li>
            <li>
              <strong>Access the Application by automated means</strong> — including bots, scripts, crawlers,
              or any client other than the official Application — or scrape, harvest, or bulk-download data
              or stored images from our services
            </li>
            <li>
              <strong>Circumvent, evade, or attempt to defeat rate limits or usage caps</strong>, including by
              rotating IP addresses, creating multiple accounts or device identities, or replaying requests
            </li>
            <li>Reverse-engineer, decompile, or disassemble any part of the Application, except to the extent expressly permitted by applicable law</li>
            <li>Use the Application in any manner that could damage, disable, overburden, or impair our servers or networks</li>
            <li>Submit photographs containing unlawful content for AI processing</li>
            <li>Resell, redistribute, or commercially exploit AI results obtained through the Application</li>
          </ul>
          <p>
            Violations of this section may result in immediate suspension or termination of your account
            and, where required, referral to law-enforcement authorities.
          </p>
        </div>
      </section>

      <!-- 8. IP -->
      <section id="ip" aria-labelledby="h-ip">
        <h2 id="h-ip" class="section-heading">Intellectual Property</h2>
        <div class="card body-text space-y-3">
          <p>
            The Application, including its design, code, graphics, and all content we produce, is owned by
            {appName} and protected by copyright, trademark, and other intellectual property laws. These
            Terms do not transfer any intellectual property rights to you.
          </p>
          <p>
            You are granted a limited, non-exclusive, non-transferable, revocable licence to install and
            use the Application on devices you own or control, solely for your personal, non-commercial
            purposes and in accordance with these Terms. This licence does not include the right to sublicence,
            modify, distribute, or create derivative works based on the Application.
          </p>
          <p>
            The {appName} name, logo, and any associated marks are trademarks of {appName}. Nothing in
            these Terms grants you the right to use any of our trademarks without our prior written consent.
          </p>
        </div>
      </section>

      <!-- 9. THIRD-PARTY SERVICES -->
      <section id="third-parties" aria-labelledby="h-third">
        <h2 id="h-third" class="section-heading">Third-Party Services</h2>
        <div class="card body-text space-y-3">
          <p>
            The Application relies on the following third-party services. Each is described, with the data
            involved, in our <a href={`${base}privacy-policy/`} class="link">Privacy Policy</a>:
          </p>
          <ul class="bullet-list">
            <li>
              <strong>Google Gemini (Google LLC)</strong> — processes identification, diagnosis and discovery
              requests. Your photographs are transmitted to Google&apos;s infrastructure. Under the terms on
              which we use Gemini, Google does not train its models on the data we submit.
            </li>
            <li>
              <strong>Open-Meteo</strong> — receives your exact coordinates, where you granted location
              permission, to return local weather used in care advice.
            </li>
            <li>
              <strong>Cloudflare R2 and Railway</strong> — image storage, application hosting and database.
            </li>
            <li>
              <strong>Resend</strong> — delivers in-app feedback you send us to our own inbox.
            </li>
            <li>
              <strong>Apple App Store / Google Play</strong> — application distribution, and Sign in with
              Apple or Google if you use it. These platforms operate under their own terms.
            </li>
          </ul>
          <p>
            We are not responsible for the availability, accuracy, or practices of third-party services.
            Your use of those services is subject to their respective terms and privacy policies.
          </p>
        </div>
      </section>

      <!-- 10. AI DISCLAIMER -->
      <section id="ai-disclaimer" aria-labelledby="h-ai">
        <h2 id="h-ai" class="section-heading">AI Results — Accuracy and Safety</h2>

        <div class="alert mb-4">
          <p class="alert-title">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            Wild plants: do not rely on this app for safety decisions
          </p>
          <p class="mb-3">
            The discovery feature returns information about <strong>edibility, medicinal use, toxicity and
            conservation status</strong> of wild plants. That information is generated by an AI model from a
            photograph. It can be confidently and completely wrong, and many toxic species closely resemble
            edible ones.
          </p>
          <p class="mb-3">
            <strong>Never use {appName} to decide whether a plant is safe to eat, taste, touch, handle,
            brew, apply to skin, or give to a child, another person, or an animal.</strong> Never use it to
            decide whether a plant may lawfully be picked or collected. If someone has eaten or touched an
            unknown plant, contact your local poison control centre or emergency services immediately — do
            not consult this app.
          </p>
          <p>
            To the fullest extent permitted by applicable law, we disclaim all liability for any harm, injury,
            illness, death, or loss arising from reliance on identification, edibility, toxicity, medicinal or
            conservation information provided by the Application. Foraging is undertaken entirely at your own
            risk, and identification of a wild plant for consumption should be confirmed by a qualified expert
            using the physical specimen.
          </p>
        </div>

        <div class="card body-text space-y-3">
          <p>
            More generally, <strong>all AI output in the Application is informational only</strong>. It is
            produced by a third-party model, may be inaccurate or incomplete, and is
            <strong>not professional horticultural, agricultural, medical, or veterinary advice</strong>.
            Care recommendations, health diagnoses and species identifications are suggestions, not
            instructions, and following them may still result in damage to or the death of a plant.
          </p>
          <p>
            {appName} makes no warranty as to the accuracy, reliability, or completeness of AI-generated
            results. Where a decision matters to you — a plant of value, a plant near children or pets, a
            plant you intend to consume, or any question of your own health or that of an animal — consult a
            qualified horticulturalist, botanist, physician, or veterinarian.
          </p>
        </div>
      </section>

      <!-- 11. DISCLAIMERS -->
      <section id="disclaimers" aria-labelledby="h-disclaimers">
        <h2 id="h-disclaimers" class="section-heading">General Disclaimers</h2>
        <div class="card body-text space-y-3">
          <p class="font-medium text-gray-700 uppercase text-xs tracking-wide">
            To the maximum extent permitted by applicable law:
          </p>
          <p>
            The Application is provided <strong>&ldquo;as is&rdquo;</strong> and
            <strong>&ldquo;as available&rdquo;</strong> without warranties of any kind, whether express
            or implied, including but not limited to implied warranties of merchantability, fitness for a
            particular purpose, and non-infringement.
          </p>
          <p>
            We do not warrant that the Application will be uninterrupted, error-free, or free from viruses
            or other harmful components. We do not warrant that any defects will be corrected, that AI
            features will be available at any given moment, or that the Application will meet your specific
            requirements.
          </p>
          <p>
            We do not warrant that photographs or other data you store with us will be preserved. Please keep
            your own copies of any photograph that matters to you.
          </p>
          <p>
            Nothing in these Terms affects any statutory rights you may have as a consumer under applicable
            law that cannot be excluded or limited by contract, and nothing in these Terms excludes or limits
            liability for death or personal injury caused by negligence, for fraud, or for any other
            liability that cannot lawfully be excluded.
          </p>
        </div>
      </section>

      <!-- 12. LIABILITY -->
      <section id="liability" aria-labelledby="h-liability">
        <h2 id="h-liability" class="section-heading">Limitation of Liability</h2>
        <div class="card body-text space-y-3">
          <p class="font-medium text-gray-700 uppercase text-xs tracking-wide">
            To the maximum extent permitted by applicable law:
          </p>
          <p>
            {appName} and its developers shall not be liable for any indirect, incidental, special,
            consequential, or punitive damages, including but not limited to loss of data, loss of profits,
            loss of plants (or plant health), or loss of goodwill, arising out of or in connection with
            your use of or inability to use the Application, even if we have been advised of the possibility
            of such damages.
          </p>
          <p>
            Our total aggregate liability to you for any claims arising under or in connection with these
            Terms shall not exceed the amount you paid us (if any) in the twelve months preceding the event
            giving rise to the claim, or <strong>€10</strong>, whichever is greater.
          </p>
          <p>
            Some jurisdictions do not allow the exclusion or limitation of certain warranties or liabilities.
            In those jurisdictions, our liability is limited to the maximum extent permitted by law, and the
            carve-outs in <a href="#disclaimers" class="link">Section&nbsp;11</a> apply.
          </p>
        </div>
      </section>

      <!-- 13. TERMINATION -->
      <section id="termination" aria-labelledby="h-termination">
        <h2 id="h-termination" class="section-heading">Termination and Suspension</h2>
        <div class="card body-text space-y-3">
          <p>
            You may stop using the Application at any time. You may delete your account via
            <strong>Settings → Account → Delete Account</strong>; server-side deletion is immediate.
            Uninstalling the Application removes locally stored data from that device but does not by itself
            delete your account.
          </p>
          <p>
            We may <strong>suspend</strong> your access — temporarily and without prior notice — where we
            reasonably believe your account is being used to abuse AI capacity, to circumvent rate limits,
            or in a way that threatens the security or availability of the service for others. Where a
            suspension is not required to be immediate, we will tell you the reason and how to resolve it.
          </p>
          <p>
            We may <strong>terminate</strong> your account where you materially or repeatedly breach these
